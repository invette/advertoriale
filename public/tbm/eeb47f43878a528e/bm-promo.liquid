{%- comment -%} Black Month 2026 (PL): pasek, CTA w hero, ramka na karcie produktu, ceny kafelków, pasek postępu w koszyku (wstawiany skryptem do szuflady i strony koszyka). Rabat od wartości koszyka (wszystkie produkty), progi w BMX_TIERS muszą być takie same jak rabaty automatyczne „Black Month −X%” w Shopify. Do 30.11.2026 23:59 CET. {%- endcomment -%}
{%- assign bmx_url = '/pages/black-month' -%}
{%- assign bmx_line = '' -%}
{%- if template.name == 'product' and product.gift_card? != true -%}{%- assign bmx_line = 'all' -%}{%- endif -%}
<div id="bmx-bar" class="bmx-bar" hidden>{%- if request.path == bmx_url -%}<div class="bmx-in">{%- else -%}<a class="bmx-in" href="{{ bmx_url }}" data-bmx-link>{%- endif -%}<span class="bmx-tag"><i></i>Black Month</span><span class="bmx-txt"><span class="bmx-l"><span class="x1">Black Friday przez cały listopad<em>/</em></span><b>Do −50%</b> na wszystko<em>/</em>Im większy koszyk, tym większy rabat</span><span class="bmx-s"><b>do −50%</b></span></span><span class="bmx-cd" data-bmx-cd></span>{%- if request.path == bmx_url -%}</div>{%- else -%}<span class="bmx-btn"><span class="bmx-bl">Zobacz ofertę</span><span class="bmx-bs">Oferta</span><i aria-hidden="true">→</i></span></a>{%- endif -%}</div>
<style>
.bmx-bar,.bmx-note{--bmx-f:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;--bmx-m:"SUSE Mono",ui-monospace,Menlo,monospace}
.bmx-bar *,.bmx-note *{box-sizing:border-box}
.bmx-bar{position:relative;z-index:30;color:#fff;background:#1F3BFF radial-gradient(120% 240% at 0% 0%,#0A0F1F 0%,rgba(10,15,31,0) 46%)}
.bmx-bar::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(70% 260% at 100% 100%,rgba(140,110,255,.75) 0%,rgba(140,110,255,0) 60%)}
.bmx-in{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:18px;min-height:46px;padding:7px 20px;max-width:1440px;margin:0 auto;color:#fff!important;text-decoration:none!important}
.bmx-tag{flex:none;display:inline-flex;align-items:center;gap:8px;background:#0A0F1F;border:1px solid rgba(255,255,255,.16);border-radius:999px;padding:6px 11px 6px 9px;font:600 10.5px/1 var(--bmx-m);letter-spacing:.14em;text-transform:uppercase;color:#fff}
.bmx-tag i,.bmx-k i{flex:none;width:6px;height:6px;border-radius:50%;background:#fff;animation:bmxp 1.8s infinite}
.bmx-k i{background:#1F3BFF;animation-name:bmxq}
@keyframes bmxp{0%{box-shadow:0 0 0 0 rgba(255,255,255,.65)}70%{box-shadow:0 0 0 7px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}
@keyframes bmxq{0%{box-shadow:0 0 0 0 rgba(31,59,255,.5)}70%{box-shadow:0 0 0 7px rgba(31,59,255,0)}100%{box-shadow:0 0 0 0 rgba(31,59,255,0)}}
.bmx-txt{min-width:0;font:500 11px/1.3 var(--bmx-m);letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bmx-txt b{color:#fff;font-weight:700}
.bmx-txt em{font-style:normal;opacity:.35;margin:0 10px}
.bmx-s{display:none}
.bmx-cd{flex:none;display:inline-flex;align-items:center;gap:4px;font:500 10px/1 var(--bmx-m);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.75)}
.bmx-cd:empty{display:none}
.bmx-cd .lb{margin-right:6px}
.bmx-cd .u{display:inline-flex;align-items:baseline;gap:2px;min-width:34px;justify-content:center;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:7px;padding:5px 6px}
.bmx-cd .u b{font:700 13px/1 var(--bmx-f);letter-spacing:0;color:#fff;font-variant-numeric:tabular-nums}
.bmx-btn{flex:none;display:inline-flex;align-items:center;gap:10px;background:#fff;color:#0A0F1F;border-radius:999px;padding:5px 5px 5px 15px;font:700 11px/1 var(--bmx-f);letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;transition:transform .4s cubic-bezier(.22,1,.36,1),box-shadow .4s}
.bmx-btn i{font-style:normal;width:24px;height:24px;border-radius:50%;background:#1F3BFF;color:#fff;display:grid;place-items:center;font-size:12px}
a.bmx-in:hover .bmx-btn{transform:translateX(2px);box-shadow:0 0 0 4px rgba(255,255,255,.18)}
.bmx-bs{display:none}
@media(max-width:1320px){.bmx-l .x1{display:none}}
@media(max-width:1100px){.bmx-cd .lb{display:none}}
@media(max-width:920px){.bmx-cd{display:none}}
@media(max-width:749px){.bmx-in{justify-content:space-between;gap:10px;min-height:44px;padding:6px 12px}.bmx-l,.bmx-bl{display:none}.bmx-s,.bmx-bs{display:inline}.bmx-txt{flex:1;text-align:center}.bmx-tag{padding:5px 9px 5px 8px;font-size:10px}.bmx-btn{padding:4px 4px 4px 12px;font-size:10.5px}.bmx-btn i{width:22px;height:22px}}
.sgh.sgh .hx-btn.bmx-hx{--btn:#0A0F1F;background:#0A0F1F;box-shadow:0 18px 40px -14px rgba(10,15,31,.6),inset 0 1px rgba(255,255,255,.14)}
.sgh.sgh .hx-btn.bmx-hx:hover{box-shadow:0 0 0 6px rgba(10,15,31,.08),0 24px 44px -14px rgba(10,15,31,.7),inset 0 1px rgba(255,255,255,.14)}
.bmx-hx .pc{color:#9DACFF}
.bmx-note{margin:16px 0;padding:16px 16px 15px;border-radius:20px;background:linear-gradient(135deg,#EEF1FF 0%,#F4EFFF 100%);border:1px solid rgba(31,59,255,.16);color:#0A0F1F;font-family:var(--bmx-f)}
.bmx-k{display:inline-flex;align-items:center;gap:8px;font:600 10.5px/1 var(--bmx-m);letter-spacing:.14em;text-transform:uppercase;color:#1F3BFF}
.bmx-nt{margin:10px 0 0!important;font:500 14px/1.45 var(--bmx-f);color:#2A3150}
.bmx-nt b{color:#0A0F1F;font-weight:700}
.bmx-tiers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;list-style:none!important;margin:12px 0 14px!important;padding:0!important}
.bmx-tiers li{margin:0!important;background:#fff;border:1px solid rgba(31,59,255,.12);border-radius:10px;padding:8px 2px 7px;text-align:center;list-style:none}
.bmx-tiers li::before,.bmx-tiers li::marker{content:none}
.bmx-tiers li span{display:block;font:500 9.5px/1 var(--bmx-m);letter-spacing:.04em;text-transform:uppercase;color:#6B7290;white-space:nowrap}
.bmx-tiers li b{display:block;margin-top:6px;font:800 15px/1 var(--bmx-f);color:#1F3BFF}
.bmx-tiers li:last-child{background:#1F3BFF;border-color:#1F3BFF}
.bmx-tiers li:last-child span{color:rgba(255,255,255,.75)}
.bmx-tiers li:last-child b{color:#fff}
.bmx-cfg{display:inline-flex;align-items:center;gap:10px;font:700 11.5px/1 var(--bmx-f);letter-spacing:.1em;text-transform:uppercase;color:#1F3BFF!important;text-decoration:none!important}
.bmx-cfg i{font-style:normal;width:24px;height:24px;border-radius:50%;background:#1F3BFF;color:#fff;display:grid;place-items:center;font-size:12px;transition:transform .4s cubic-bezier(.22,1,.36,1)}
.bmx-cfg:hover i{transform:translateX(3px)}
@media(max-width:480px){.bmx-tiers{gap:3px}.bmx-tiers li{padding:7px 1px 6px}.bmx-tiers li b{font-size:12.5px}.bmx-tiers li span{font-size:8.5px;letter-spacing:0}}
.bmx-rib{position:absolute;top:-9px;right:14px;z-index:2;background:#1F3BFF;color:#fff;border-radius:999px;padding:4px 9px;font:600 9.5px/1 "SUSE Mono",ui-monospace,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase;box-shadow:0 6px 14px -6px rgba(31,59,255,.6);pointer-events:none;white-space:nowrap}
.tiles .tile .pr .p.bmx-pn{color:#1F3BFF}
.buy .price .bmx-pchip{display:inline-flex;align-items:center;align-self:center;margin-left:4px;border:1px solid rgba(31,59,255,.35);color:#1F3BFF;border-radius:999px;padding:6px 10px;font:600 10px/1 "SUSE Mono",ui-monospace,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}
.buy .price .bmx-pchip.on{background:#1F3BFF;border-color:#1F3BFF;color:#fff}
.buy .price .bmx-om{margin:6px 0 0;font:500 11.5px/1.4 "Instrument Sans",system-ui,sans-serif;color:#646B85}
@media(max-width:480px){.buy .price .bmx-pchip{padding:5px 8px;font-size:9px}}
@media(prefers-reduced-motion:reduce){.bmx-tag i,.bmx-k i{animation:none}}
.bmc{--bmc-f:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;--bmc-m:"SUSE Mono",ui-monospace,Menlo,monospace;display:grid;gap:8px;padding:14px 14px 12px;border-radius:16px;background:linear-gradient(135deg,#EEF1FF 0%,#F4EFFF 100%);border:1px solid rgba(31,59,255,.16);color:#0A0F1F;font-family:var(--bmc-f);text-align:left}
.bmc *{box-sizing:border-box}
.bmc-h{display:flex;align-items:center;justify-content:space-between;gap:10px}
.bmc-k{display:inline-flex;align-items:center;gap:7px;font:600 10px/1 var(--bmc-m);letter-spacing:.14em;text-transform:uppercase;color:#1F3BFF}
.bmc-k i{width:6px;height:6px;border-radius:50%;background:#1F3BFF}
.bmc-d{font:800 13px/1 var(--bmc-f);color:#0A0F1F;white-space:nowrap}
.bmc-d.on{color:#1F3BFF}
.bmc-t{margin:0!important;font:500 13px/1.4 var(--bmc-f);color:#2A3150}
.bmc-t b{color:#0A0F1F;font-weight:700}
.bmc-bar{position:relative;height:8px;border-radius:99px;background:rgba(31,59,255,.14);overflow:hidden}
.bmc-bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px;background:#1F3BFF;transition:width .5s cubic-bezier(.22,1,.36,1)}
.bmc-s{display:flex;justify-content:space-between;gap:8px;font:600 9.5px/1 var(--bmc-m);letter-spacing:.06em;text-transform:uppercase;color:#6B7290}
.bmc-s b{color:#1F3BFF;font-weight:700}
.main-cart-bmc{margin-bottom:4px}
</style>
{%- if template.name == 'product' -%}
<script>window.bmxPack={ {%- for v in product.variants -%}"{{ v.id }}":{{ v.title | split: ' ' | first | plus: 0 }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} };{%- assign bmx_one = 0 -%}{%- for v in product.variants -%}{%- assign bmx_n = v.title | split: ' ' | first | plus: 0 -%}{%- if bmx_n == 1 and bmx_one == 0 -%}{%- assign bmx_one = v.id -%}{%- endif -%}{%- endfor -%}window.bmxOne={% if bmx_one == 0 %}null{% else %}{{ bmx_one }}{% endif %};window.bmxLine="{{ bmx_line }}";</script>
{%- endif -%}
<script>
(function(){
  var S=Date.parse('2026-11-01T00:00:00+01:00'),E=Date.parse('2026-12-01T00:00:00+01:00'),SWAP=true,now=Date.now();
  if(now>=E)return;
  var TV=[[400,10],[600,20],[1000,25],[2000,30],[3000,35],[4000,40],[5000,45],[6000,50]];
  function kz(z){return String(z).replace(/\B(?=(\d{3})+(?!\d))/g,'.')+' zł'}
  function zl(c){var v=(Math.round(c)/100).toFixed(2).split('.');return v[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+v[1]+' zł'}
  var started=now>=S,prev=!!(window.Shopify&&Shopify.theme&&Shopify.theme.role&&Shopify.theme.role!=='main'),show=started||prev;
  var bar=document.getElementById('bmx-bar');if(bar)bar.hidden=false;
  var cd=bar&&bar.querySelector('[data-bmx-cd]');
  function p(n){return (n<10?'0':'')+n}
  function seg(v,u){return '<span class="u"><b>'+v+'</b>'+u+'</span>'}
  function tick(){if(!cd)return;var n=Date.now(),t,l;if(n<S){t=S-n;l='Start za'}else if(n<E){t=E-n;l='Koniec za'}else{if(bar)bar.hidden=true;return}
    var s=Math.floor(t/1000),d=Math.floor(s/86400);
    cd.innerHTML='<span class="lb">'+l+'</span>'+(d?seg(d,'d'):'')+seg(p(Math.floor(s%86400/3600)),'h')+seg(p(Math.floor(s%3600/60)),'m')+seg(p(s%60),'s')}
  tick();setInterval(tick,1000);
  if(!started&&bar&&''){var a0=bar.querySelector('[data-bmx-link]');if(a0){a0.href='';var bl=a0.querySelector('.bmx-bl'),bs=a0.querySelector('.bmx-bs');if(bl)bl.textContent='';if(bs)bs.textContent=''}}
  function ready(f){document.readyState==='loading'?document.addEventListener('DOMContentLoaded',f):f()}
  ready(function(){
    if(!show)return;
    var hc=document.querySelector('.hx-cta');
    if(hc&&!document.querySelector('.bmx-hx')){var a=document.createElement('a');a.className='hx-btn bmx-hx';a.href='{{ bmx_url }}';a.innerHTML='<span>Black Month <span class="pc">do −50%</span></span><i aria-hidden="true">→</i>';hc.appendChild(a)}
    document.querySelectorAll('a[href*="/pages/bundle-creator"]').forEach(function(a){a.href=a.getAttribute('href').replace('/pages/bundle-creator','{{ bmx_url }}')});
    var L=window.bmxLine;if(!L)return;
    var f=document.querySelector('form[action*="/cart/add"]');
    if(f&&!document.querySelector('.bmx-note')){var b=document.createElement('div');b.className='bmx-note';
      b.innerHTML='<span class="bmx-k"><i></i>Black Month · do 30.11</span><p class="bmx-nt">Rabat rośnie razem z wartością koszyka i obejmuje <b>wszystkie produkty</b>, peptydy i nutraceutyki razem. Nalicza się sam, bez kodu.</p><ol class="bmx-tiers">'+TV.map(function(t){return '<li><span>od '+kz(t[0])+'</span><b>−'+t[1]+'%</b></li>'}).join('')+'</ol><a class="bmx-cfg" href="{{ bmx_url }}">Złóż własny zestaw<i aria-hidden="true">→</i></a>';
      f.parentNode.insertBefore(b,f)}
    if(document.querySelector('.tiles input[type=radio]')){
      document.addEventListener('change',function(e){if(e.target&&e.target.matches&&e.target.matches('.tiles input[type=radio]'))setTimeout(bmUpd,0)});
      document.addEventListener('click',function(e){if(e.target&&e.target.closest&&e.target.closest('#sgk-pf .stepper button'))setTimeout(bmUpd,0)});
      bmUpd();setTimeout(bmUpd,300);addEventListener('load',bmUpd)}
  });
  /* ceny Black Month na kafelkach i w cenie głównej (karta produktu) */
  function tierPct(c){var p=0;TV.forEach(function(t){if(c>=t[0]*100)p=t[1]});return p}
  function nextTier(c){for(var i=0;TV.length>i;i++)if(TV[i][0]*100>c)return TV[i];return null}
  var fmt=null;
  function mkFmt(){var smps=[].slice.call(document.querySelectorAll('.tiles .tile .p')).map(function(e){return e.getAttribute('data-bmx0')||e.textContent.trim()});if(!smps.length)return null;
    var smp=smps[0],re=/\d[\d.,\s]*\d/,m=smp.match(re);if(!m)return null;var num=m[0],dec=num.charAt(num.length-3),hasDec=(dec===','||dec==='.'),th=null;
    smps.forEach(function(x){var mm=x.match(re);if(mm){var ip=hasDec?mm[0].slice(0,-3):mm[0],y=ip.match(/[^\d]/);if(y&&th===null)th=y[0]}});
    if(th===null)th=hasDec?(dec===','?'.':','):'';
    return function(c){var v=(Math.round(c)/100).toFixed(2).split('.'),i=v[0].replace(/\B(?=(\d{3})+(?!\d))/g,th);return smp.replace(num,hasDec?i+dec+v[1]:i)}}
  function dpk(p,n,pct){var u=Math.round(p/n);return (u-Math.floor(u*pct/100+1e-9))*n}
  function bmUpd(){
    var L=window.bmxLine;if(!L||!show||Date.now()>=E)return;
    var radios=[].slice.call(document.querySelectorAll('.tiles input[type=radio]'));if(!radios.length)return;
    if(!fmt)fmt=mkFmt();if(!fmt)return;
    var form=document.getElementById('sgk-pf'),qin=form&&form.querySelector('input[name=quantity]'),q=Math.max(1,parseInt(qin&&qin.value||'1',10)||1);
    radios.forEach(function(r){var tile=r.closest('.tile'),pe=tile&&tile.querySelector('.pr .p'),se=tile&&tile.querySelector('.pr s');if(!pe)return;
      if(!pe.hasAttribute('data-bmx0'))pe.setAttribute('data-bmx0',pe.textContent.trim());
      var p=+r.getAttribute('data-p'),n=+r.getAttribute('data-n')||1,pct=p?tierPct(p*q):0,rib=tile.querySelector('.bmx-rib');
      if(pct>0){pe.textContent=fmt(dpk(p,n,pct));pe.classList.add('bmx-pn');if(se){se.textContent=fmt(p);se.hidden=false}if(!rib){rib=document.createElement('span');rib.className='bmx-rib';tile.appendChild(rib)}rib.textContent='Black Month −'+pct+'%'}
      else{pe.textContent=pe.getAttribute('data-bmx0');pe.classList.remove('bmx-pn');if(se)se.textContent='';if(rib)rib.remove()}});
    var r=radios.filter(function(x){return x.checked})[0]||radios[0],pr=document.querySelector('.buy .price');if(!pr)return;
    var p=+r.getAttribute('data-p'),n=+r.getAttribute('data-n')||1,days=+r.getAttribute('data-d')||(+pr.getAttribute('data-jd')||30)*n,pct=p?tierPct(p*q):0;
    var row=pr.querySelector('.price-row'),chip=pr.querySelector('.bmx-pchip');if(!chip&&row){chip=document.createElement('span');chip.className='bmx-pchip';row.appendChild(chip)}
    var om=pr.querySelector('.bmx-om');
    if(pct>0){var pk=dpk(p,n,pct),tot=pk*q;
      var nw=pr.querySelector('.now');if(nw)nw.textContent=fmt(tot);
      var s=pr.querySelector('.price-row s');if(s){s.hidden=false;s.textContent=fmt(p*q)}
      var b=pr.querySelector('.sv b');if(b){b.hidden=false;var bs=b.querySelector('span');if(bs)bs.textContent=fmt(p*q-tot)}
      var pj=pr.querySelector('.pj');if(pj)pj.textContent=fmt(Math.floor(pk/n));var pd=pr.querySelector('.pd');if(pd)pd.textContent=fmt(Math.floor(pk/days));
      var sp=document.querySelector('#sgk-st .sp');if(sp)sp.textContent=fmt(tot);
      if(chip){chip.className='bmx-pchip on';chip.textContent='Black Month −'+pct+'%'}
      if(!om){om=document.createElement('p');om.className='bmx-om';pr.appendChild(om)}om.textContent='Najniższa cena z 30 dni przed obniżką: '+fmt(Math.round(p/n))+' za słoik.';
    }else{var nt=nextTier(p*q);if(chip){if(nt){chip.className='bmx-pchip';chip.textContent='Black Month: od '+kz(nt[0])+' −'+nt[1]+'%'}else chip.remove()}if(om)om.remove()}
  }
  /* pasek postępu w koszyku: odświeżanie po każdej zmianie koszyka */
  function bmcHtml(c){var cur=0,lo=0,hi=0,nx=0;TV.forEach(function(t){var a=t[0]*100;if(c>=a){cur=t[1];lo=a}else if(!hi){hi=a;nx=t[1]}});
    var pr=hi?Math.max(0,Math.min(100,Math.floor((c-lo)*100/(hi-lo)))):100,t;
    if(!hi)t='Masz maksymalny rabat <b>−'+cur+'%</b> na cały koszyk.';
    else if(!cur)t='Dodaj produkty za <b>'+zl(hi-c)+'</b>, a dostaniesz <b>−'+nx+'%</b> na cały koszyk.';
    else t='Masz <b>−'+cur+'%</b>. Dodaj produkty za <b>'+zl(hi-c)+'</b>, a rabat wzrośnie do <b>−'+nx+'%</b>.';
    return '<div class="bmc-h"><span class="bmc-k"><i></i>Black Month</span><b class="bmc-d'+(cur?' on':'')+'">'+(cur?'Twój rabat −'+cur+'%':'Rabat od '+kz(TV[0][0]))+'</b></div><p class="bmc-t">'+t+'</p><div class="bmc-bar"><i style="width:'+pr+'%"></i></div><div class="bmc-s"><span>'+(cur?'−'+cur+'%':'0%')+'</span><span>'+(hi?'<b>−'+nx+'%</b> od '+kz(hi/100):'<b>−'+cur+'%</b>')+'</span></div>'}
  var bmcLast=null;
  function bmcSpots(){var r=[],dr=document.querySelector('#CartDrawer [id^="MiniCart-"] .drawer__scrollable.gap-9')||document.querySelector('#CartDrawer .drawer__scrollable.gap-9'),pg=document.querySelector('main-cart .grow');if(dr)r.push([dr,'drawer']);if(pg)r.push([pg,'page']);return r}
  function bmcPaint(){if(bmcLast===null)return;document.querySelectorAll('[data-bmc]').forEach(function(el){el.hidden=!bmcLast.n;el.innerHTML=bmcHtml(bmcLast.v)})}
  function bmcEnsure(){if(!show||Date.now()>=E)return false;var added=false;bmcSpots().forEach(function(x){var host=x[0];if(host.querySelector(':scope > [data-bmc]'))return;var el=document.createElement('div');el.className='bmc'+(x[1]==='page'?' main-cart-bmc':'');el.setAttribute('data-bmc','');el.hidden=true;var fs=host.querySelector(':scope > .free-shipping-bar');if(fs)fs.insertAdjacentElement('afterend',el);else host.insertBefore(el,host.firstChild);added=true});if(added)bmcPaint();return !!document.querySelector('[data-bmc]')}
  function bmcRefresh(){if(!bmcEnsure())return;
    fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json()}).then(function(c){bmcLast={n:c.item_count,v:c.original_total_price};bmcPaint()}).catch(function(){})}
  if(show&&Date.now()<E){
    if(window.fetch&&!window.__bmcF){window.__bmcF=1;var of=window.fetch;window.fetch=function(u){var url=typeof u==='string'?u:(u&&u.url)||'',r=of.apply(this,arguments);if(/\/cart\/(add|change|update|clear)/.test(url))r.then(function(){setTimeout(bmcRefresh,450)},function(){});return r}}
    document.addEventListener('cart:refresh',function(){setTimeout(bmcRefresh,300)});
    ready(function(){bmcRefresh();var cd=document.getElementById('CartDrawer'),tm=null;if(cd&&window.MutationObserver)new MutationObserver(function(){clearTimeout(tm);tm=setTimeout(bmcEnsure,60)}).observe(cd,{childList:true,subtree:true})});
  }
  /* pakiet "3 szt." x1 -> 1 szt. x3 przy dodaniu do koszyka, żeby rabat ilościowy się naliczył (cena ta sama) */
  if(SWAP)document.addEventListener('submit',function(e){
    var f=e.target;if(!f||!f.matches||!f.matches('form[action*="/cart/add"]')||!window.bmxOne||!window.bmxPack)return;
    var idI=f.querySelector('[name="id"]');if(!idI)return;var n=window.bmxPack[idI.value];if(!n||n<2)return;
    var q=f.querySelector('[name="quantity"]'),oId=idI.value,oQ=q?q.value:null,qty=q?(parseInt(q.value||'1',10)||1):1,added=null;
    idI.value=window.bmxOne;
    if(q){q.value=n*qty}else{added=document.createElement('input');added.type='hidden';added.name='quantity';added.value=n*qty;f.appendChild(added)}
    setTimeout(function(){idI.value=oId;if(q)q.value=oQ;if(added)added.remove()},0);
  },true);
})();
</script>
